# The same value as the web app's DATABASE_URL: the worker keeps its tables (jobs, cron_runs)
# in the app's Postgres. In Coolify it is set by the runbook, never typed by hand.
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<db>
# The health route (no domain; only Coolify's and Docker's checks call it).
PORT=3000
# How often the loop looks for due jobs and cron slots.
WORKER_POLL_MS=2000
# The built-in prune job deletes done and failed jobs older than this.
WORKER_PRUNE_DAYS=14
# A job left "running" this long (its container was killed) goes back to the queue.
WORKER_LOCK_SECONDS=900
# The health route answers 503 when the loop has not ticked for this long (a stuck job).
WORKER_STALE_SECONDS=300
