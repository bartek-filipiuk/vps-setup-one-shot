# Local dev: docker run -d --name auth-db -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:17-alpine
# On Coolify: the database's internal URL, set through app_env_set (AUTH.md step 4).
DATABASE_URL=postgres://postgres:dev@localhost:5432/postgres

# The public address: the base of the sign-in link, the origin every form must come from, and
# https:// marks the session cookie Secure. No trailing path.
SITE_URL=http://localhost:3000

# Optional: the name in the mail and the page title (default: the host of SITE_URL).
# APP_NAME=My App

# The sender, an address or domain your SMTP provider has verified.
MAIL_FROM="My App <no-reply@example.com>"

# SMTP from your provider, one URL: smtp://LOGIN:PASSWORD@HOST:587 (STARTTLS, required; use it on
# Hetzner, where outgoing 465 and 25 may be blocked, AUTH.md step 0) or smtps://LOGIN:PASSWORD@HOST:465
# (TLS). Percent-encode @ : / % # in the login and password.
# A secret: on Coolify only through app_env_set on stdin (AUTH.md step 5), never in this file.
# SMTP_URL=

# Local dev and CI only: MAIL_LOG=1 sends nothing and prints each mail, sign-in link included,
# to the log. Anyone who reads the log can then sign in: never on a server.
MAIL_LOG=1
