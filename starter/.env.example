# Local dev: docker run -d --name starter-db -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:17-alpine
# On Coolify: use the database's internal URL (Coolify shows it on the database page).
DATABASE_URL=postgres://postgres:dev@localhost:5432/postgres

# Optional: email list via Brevo double opt-in. Leave unset and signups only go to Postgres.
# SITE_URL is the public origin; Brevo sends people back to /confirmed or /pl/potwierdzone.
# BREVO_API_KEY=
# BREVO_LIST_EN=
# BREVO_LIST_PL=
# BREVO_DOI_TEMPLATE_EN=
# BREVO_DOI_TEMPLATE_PL=
# SITE_URL=https://example.com
